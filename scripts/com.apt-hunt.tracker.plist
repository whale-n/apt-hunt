<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Keeps the tracker UI running at http://localhost:8765. Install: make install-tracker -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.apt-hunt.tracker</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>-lc</string>
    <string>cd "$HOME/apt-hunt" &amp;&amp; exec /opt/homebrew/bin/uv run uvicorn ui.app:app --host 127.0.0.1 --port 8765</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>30</integer>
  <key>StandardOutPath</key><string>/tmp/apt-hunt-tracker.log</string>
  <key>StandardErrorPath</key><string>/tmp/apt-hunt-tracker.log</string>
</dict>
</plist>
